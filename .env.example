# Template for the local .env file. Copy and adjust:
#     cp .env.example .env
# The real .env is excluded from git via .gitignore.

# Port published on the host. Inside the container Apache
# always listens on 80.
HOST_PORT=8080

# Database name and credentials. On first start the MySQL container
# creates this database and user; Compose passes the same values to
# WordPress (see docker-compose.yaml), so they only live here.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me
